# Copy to .env and fill in. Never commit .env.

# ClickUp > avatar (bottom-left) > Settings > Apps > API Token > Generate
CLICKUP_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxx

# Workspace (team) id. Run `npm run discover` to list the ids you can use.
CLICKUP_TEAM_ID=

# Limit to the Design team's Space(s). Comma-separated. Leave empty = whole workspace.
CLICKUP_SPACE_IDS=

# Optional: limit to specific Lists instead of whole Spaces. Comma-separated.
CLICKUP_LIST_IDS=

# Meetings: tasks carrying this tag (case-insensitive) are shown in the Meetings section.
MEETING_TAG=meeting

# Optional: Lists whose tasks are all meetings. Comma-separated.
MEETING_LIST_IDS=

# Dashboard
# Local dev API port (ng serve proxies /api to it)
API_PORT=3111
CACHE_TTL_SECONDS=60
# Shared password for the dashboard. Leave empty for open access on localhost.
# SET THIS on Vercel: the URL is public, the data is internal.
DASHBOARD_PASSWORD=
# Week boundaries and "due today" use this timezone.
TZ=Asia/Bangkok

# Set to 1 to run with sample data (no ClickUp needed).
MOCK=0
